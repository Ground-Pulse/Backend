PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/groundpulse?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="super-secret-jwt-key"
JWT_EXPIRATION="15m"
REFRESH_TOKEN_EXPIRATION="7d"
ALLOWED_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3001"

# Media: "local" stores uploads in ./uploads (dev, no AWS needed); "s3" uses the bucket below
MEDIA_DRIVER="local"
UPLOAD_DIR="uploads"
# MEDIA_PUBLIC_BASE_URL="https://cdn.example.com"
RATE_LIMIT_PER_MINUTE=600
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
S3_BUCKET="groundpulse-media-dev"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="test"
SMTP_PASS="test"
EMAIL_FROM="GroundPulse <notifications@groundpulse.com>"
